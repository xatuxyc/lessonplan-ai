<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lessonplan.mappers.LessonPlanMapper">

    <resultMap id="base_result_map" type="com.lessonplan.entity.po.LessonPlan">
        <id column="id" property="id"/>
        <result column="file_name" property="fileName"/>
        <result column="stored_name" property="storedName"/>
        <result column="file_type" property="fileType"/>
        <result column="file_size" property="fileSize"/>
        <result column="uploader" property="uploader"/>
        <result column="upload_time" property="uploadTime"/>
        <result column="status" property="status"/>
        <result column="file_path" property="filePath"/>
    </resultMap>

    <sql id="base_column_list">
        id, file_name, stored_name, file_type, file_size, uploader, upload_time, status, file_path
    </sql>

    <select id="selectList" resultMap="base_result_map">
        SELECT <include refid="base_column_list"/>
        FROM lesson_plan
        ORDER BY upload_time DESC
        LIMIT #{offset}, #{limit}
    </select>

    <select id="selectCount" resultType="java.lang.Integer">
        SELECT count(1) FROM lesson_plan
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="bean.id" keyColumn="id">
        INSERT INTO lesson_plan
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="bean.fileName != null">file_name,</if>
            <if test="bean.storedName != null">stored_name,</if>
            <if test="bean.fileType != null">file_type,</if>
            <if test="bean.fileSize != null">file_size,</if>
            <if test="bean.uploader != null">uploader,</if>
            <if test="bean.uploadTime != null">upload_time,</if>
            <if test="bean.status != null">status,</if>
            <if test="bean.filePath != null">file_path,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="bean.fileName != null">#{bean.fileName},</if>
            <if test="bean.storedName != null">#{bean.storedName},</if>
            <if test="bean.fileType != null">#{bean.fileType},</if>
            <if test="bean.fileSize != null">#{bean.fileSize},</if>
            <if test="bean.uploader != null">#{bean.uploader},</if>
            <if test="bean.uploadTime != null">#{bean.uploadTime},</if>
            <if test="bean.status != null">#{bean.status},</if>
            <if test="bean.filePath != null">#{bean.filePath},</if>
        </trim>
    </insert>

    <select id="selectById" resultMap="base_result_map">
        SELECT <include refid="base_column_list"/>
        FROM lesson_plan
        WHERE id = #{id}
    </select>

    <update id="updateById">
        UPDATE lesson_plan
        <set>
            <if test="bean.fileName != null">file_name = #{bean.fileName},</if>
            <if test="bean.storedName != null">stored_name = #{bean.storedName},</if>
            <if test="bean.fileType != null">file_type = #{bean.fileType},</if>
            <if test="bean.fileSize != null">file_size = #{bean.fileSize},</if>
            <if test="bean.uploader != null">uploader = #{bean.uploader},</if>
            <if test="bean.uploadTime != null">upload_time = #{bean.uploadTime},</if>
            <if test="bean.status != null">status = #{bean.status},</if>
            <if test="bean.filePath != null">file_path = #{bean.filePath},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM lesson_plan WHERE id = #{id}
    </delete>

</mapper>
